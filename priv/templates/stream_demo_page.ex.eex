@moduledoc """
SSE streaming demo page.

`GET /stream-demo` renders the page; `data-init={connect()}` immediately
POSTs back to open the SSE stream. `handle_connect/2` subscribes to
<%= inspect ticker_module %>'s PubSub topic, and every broadcast lands in
`handle_info/2`, which patches the browser signals — no polling, no
JavaScript.

Generated by `mix star_view.setup.stream_page` — delete freely.
"""

use StarView.Page

alias <%= inspect layout_module %>

@impl StarView.Page
def render(assigns) do
  ~H"""
  <Layout.app conn={@conn}>
    <div
      class="max-w-xl mx-auto p-6 space-y-4"
      data-signals={~s({"time": "—", "tick": 0})}
      data-init={connect()}
      data-on:online__window={connect()}
    >
      <h1 class="text-2xl font-bold">SSE Stream Demo</h1>

      <p>
        Server time:
        <span class="font-mono" data-text="$time"></span>
      </p>

      <p>
        Ticks since connect:
        <span class="font-mono" data-text="$tick"></span>
      </p>

      <p class="text-sm opacity-70">
        Updates are pushed by <code><%= inspect ticker_module %></code> over
        Phoenix.PubSub every second.
      </p>
    </div>
  </Layout.app>
  """
end

@impl StarView.Page
def handle_connect(conn, _params) do
  Phoenix.PubSub.subscribe(<%= inspect pubsub_module %>, <%= inspect ticker_module %>.topic())
  assign(conn, tick: 0)
end

@impl StarView.Page
def handle_info({:tick, time}, conn) do
  # Loop state lives in conn assigns; the browser state lives in signals.
  conn = update(conn, :tick, &(&1 + 1))
  patch_signals(conn, %{time: time, tick: conn.assigns.tick})
end


@impl StarView.Page
def handle_disconnect(conn) do
  Phoenix.PubSub.unsubscribe(<%= inspect pubsub_module %>, <%= inspect ticker_module %>.topic())
  conn
end
