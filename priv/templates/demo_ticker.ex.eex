@moduledoc """
Broadcasts the current server time over Phoenix.PubSub every second —
powers the StarView stream demo page.

Generated by `mix star_view.setup.stream_page` — delete freely (remove it
from your application's supervision tree too).
"""

use GenServer

@topic "star_view:demo_ticker"
@interval :timer.seconds(1)

@doc "The PubSub topic ticks are broadcast on."
def topic(), do: @topic

def start_link(opts) do
  GenServer.start_link(__MODULE__, opts, name: __MODULE__)
end

@impl GenServer
def init(_opts) do
  schedule_tick()
  {:ok, nil}
end

@impl GenServer
def handle_info(:tick, state) do
  Phoenix.PubSub.broadcast(<%= inspect pubsub_module %>, @topic, {:tick, formatted_time()})
  schedule_tick()
  {:noreply, state}
end

defp schedule_tick(), do: Process.send_after(self(), :tick, @interval)

defp formatted_time() do
  DateTime.utc_now()
  |> DateTime.to_time()
  |> Time.truncate(:second)
  |> Time.to_string()
end
